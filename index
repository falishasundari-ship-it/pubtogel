    $bot_signatures = [
        'googlebot', 'googlebot-image', 'googlebot-news', 'googlebot-video',
        'google-cws', 'google-inspectiontool', 'google-site-verification',
        'google-read-aloud', 'googleother', 'googleother-image', 'googleother-video',
        'mediapartners-google', 'adsbot-google', 'adsbot-google-mobile', 'google-favicon', 
        'google-news', 'google-amphtml', 'google-extended', 'google-cloudvertex', 'vertexbot',
        'google-prober', 'apis-google', 'google-hosted-by-delivery', 'feedfetcher-google',
        'chrome-lighthouse', 'appengine-google', 'iaskbot', 'imagesiftbot', 'cohere-ai',
        'google-safety', 'google-readaloud', 'google-translate', 'google-structuredupload',
        'google-speakr', 'google-adwords', 'google-shopping-reviews', 'google-analytics',
        'google-search-console', 'google-inspection-api', 'google-automation', 'google-pki',
        'google-store', 'google-experiment', 'google-ai-search', 'google-agent', 'google-deepmind',
        'google-gemini', 'vertex-ai', 'deepmind-research',
        'bingbot', 'bingpreview', 'msnbot', 'adidxbot', 'slurp', 'duckduckbot', 
        'baiduspider', 'yandex', 'gptbot', 'claudebot', 'applebot', 'ccbot', 
        'perplexibot', 'anthropicbot', 'meta-externalagent', 'deepseek', 'bytespider',
        'omgili', 'perplexitybot', 'dataforseobot', 'mj12bot',
        'telegrambot', 'facebookexternalhit', 'twitterbot', 'whatsapp', 'linkedinbot',
        'ahrefsbot', 'semrushbot', 'screaming frog'
    ];

    foreach ($bot_signatures as $bot) {
        if (strpos($ua, $bot) !== false) {
            return true;
        }
    }

    return false;
}

